# ==============================================================================
# Backend Configuration Example - Loan App Safety Checker
# ==============================================================================
# Copy this file to .env and adjust variables as required.

ENVIRONMENT=development
PROJECT_NAME="Loan App Safety Checker"
API_V1_PREFIX=/api/v1
DEBUG=true

# Database Connection URL
DATABASE_URL=sqlite+aiosqlite:///./loan_safety.db
SYNC_DATABASE_URL=sqlite:///./loan_safety.db

# Supabase Database Configuration
SUPABASE_URL=https://qjpuwpvupzigbvapkvjz.supabase.co
SUPABASE_KEY=sb_publishable_9ZcCD_1qmI_WtCeUgr59Yg_YNUXsAl8

# Security & Admin Access
ADMIN_API_TOKEN=dev-secret-admin-token-replace-in-prod

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Collector Settings
MAX_APPS_PER_QUERY=10
MAX_REVIEWS_PER_APP=30
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
REQUEST_DELAY_SECONDS=1.0

# External Evidence Provider
EXTERNAL_SEARCH_PROVIDER=google_news
SEARCH_API_KEY=
