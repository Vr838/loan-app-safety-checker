# ==============================================================================
# Backend Configuration Example - Loan App Safety Checker
# ==============================================================================
# Copy this file to .env and adjust variables as required.
# DO NOT COMMIT SECRETS OR SENSITIVE CREDENTIALS TO SOURCE CONTROL.

# Application Environment (development, testing, production)
ENVIRONMENT=development
PROJECT_NAME="Loan App Safety Checker"
API_V1_PREFIX=/api/v1
DEBUG=true

# Database Connection URL
# For local development with zero dependencies, SQLite works out-of-the-box:
DATABASE_URL=sqlite+aiosqlite:///./loan_safety.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/loan_safety

# Sync Database Connection URL (used by Alembic migrations)
SYNC_DATABASE_URL=sqlite:///./loan_safety.db
# SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/loan_safety

# Security & Admin Access
# Set a strong random token for authorizing POST /api/v1/admin/scans
ADMIN_API_TOKEN=dev-secret-admin-token-replace-in-prod

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Collector Settings
MAX_APPS_PER_QUERY=10
MAX_REVIEWS_PER_APP=30
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
REQUEST_DELAY_SECONDS=1.0

# External Evidence Provider (optional)
# Allowed: 'google_news', 'duckduckgo', 'serpapi', or 'disabled'. Public search results are
# shown as unverified provenance and do not receive a regulatory status.
EXTERNAL_SEARCH_PROVIDER=google_news
SEARCH_API_KEY=
